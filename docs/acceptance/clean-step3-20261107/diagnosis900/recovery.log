# /etc/systemd/system/host-queue.service
[Unit]
Description=Trusted local host shared command queue
After=network-online.target
Wants=network-online.target
[Service]
ExecStart=/usr/local/sbin/host-queue
Restart=on-failure
[Install]
WantedBy=multi-user.target
#!/bin/bash
set -u
mkdir -p /mnt/host
mountpoint -q /mnt/host || mount -t 9p -o trans=virtio,version=9p2000.L,msize=262144 hostshare /mnt/host
printf 'ready %s
' "$(date --iso-8601=seconds)" > /mnt/host/ready
while :; do
 for cmd in /mnt/host/queue/*.sh; do
  [ -f "$cmd" ] || continue
  id=$(basename "$cmd" .sh)
  mv "$cmd" "$cmd.running"
  bash "$cmd.running" > "/mnt/host/results/$id.log" 2>&1
  rc=$?
  printf '%s
' "$rc" > "/mnt/host/results/$id.rc.tmp"
  mv "/mnt/host/results/$id.rc.tmp" "/mnt/host/results/$id.rc"
  mv "$cmd.running" "$cmd.done"
 done
 sleep 1
done
